# WZI SaaS Core Stack
COMPOSE_PROJECT_NAME=wzi-core
TZ=Asia/Kuala_Lumpur

# Domain
WZI_ROOT_DOMAIN=wzisaas.com
WZI_APP_DOMAIN=app.wzisaas.com
N8N_HOST=n8n.wzisaas.com

# PostgreSQL
POSTGRES_DB=wzi_saas
POSTGRES_USER=wzi_admin
POSTGRES_PASSWORD=PASTE_POSTGRES_PASSWORD_HERE

# Redis
REDIS_PASSWORD=PASTE_REDIS_PASSWORD_HERE

# n8n
N8N_ENCRYPTION_KEY=PASTE_N8N_ENCRYPTION_KEY_HERE
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.wzisaas.com/
N8N_EDITOR_BASE_URL=https://n8n.wzisaas.com/
GENERIC_TIMEZONE=Asia/Kuala_Lumpur

# SSL
ACME_EMAIL=YOUR_ADMIN_EMAIL
